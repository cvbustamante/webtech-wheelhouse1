<h1>Bikes</h1>

<%= link_to "New bike", new_bike_path, class: "btn btn-primary mb-3" %>

<% if @bikes.empty? %>
  <p class="text-muted">No bikes yet.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Serial number</th>
        <th>Model</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% end %>
