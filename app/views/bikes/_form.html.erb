<%= form_with model: bike do |f| %>
  <% if bike.errors.any? %>
    <div class="alert alert-danger"><%= bike.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, Customer.by_name, :id, :name, { prompt: "Choose a customer" },
        class: ["form-select", { "is-invalid" => bike.errors[:customer].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:customer].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :bike_model_id, "Model", class: "form-label" %>
    <%= f.collection_select :bike_model_id, BikeModel.by_name, :id, :name, { prompt: "Choose a model" },
        class: ["form-select", { "is-invalid" => bike.errors[:bike_model].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:bike_model].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: ["form-control", { "is-invalid" => bike.errors[:serial_number].any? }] %>
    <div class="invalid-feedback"><%= bike.errors[:serial_number].to_sentence %></div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", bike.persisted? ? bike : bikes_path, class: "btn btn-outline-secondary" %>
<% end %>
