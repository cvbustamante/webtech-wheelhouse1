<% content_for :title, @bike.serial_number %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @bike.serial_number %></h1>
    <p class="card-text">Model: <%= @bike.bike_model.name %></p>
    <p class="card-text">Owner: <%= link_to @bike.customer.name, @bike.customer %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-outline-secondary" %>
  <%= button_to "Delete", @bike, method: :delete, data: { turbo_confirm: "Delete #{@bike.serial_number}?" }, class: "btn btn-outline-danger d-inline-block" %>
</div>

<h2 class="h5 mt-4"><%= pluralize(@bike.repairs.size, "repair") %></h2>
<%= link_to "New repair", new_repair_path(bike_id: @bike.id), class: "btn btn-primary btn-sm mb-2" %>

<% if @bike.repairs.empty? %>
  <p class="text-muted">No repairs yet.</p>
<% else %>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Customer</th>
        <th>Mechanic</th>
        <th>Status</th>
        <th>Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bike.repairs.by_promised_on %>
    </tbody>
  </table>
<% end %>

<%= link_to "All bikes", bikes_path, class: "btn btn-outline-secondary mt-3" %>
