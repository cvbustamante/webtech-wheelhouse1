<h1>Staff</h1>

<% if @staff_members.empty? %>
  <p class="text-muted">No staff yet.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Role</th>
      </tr>
    </thead>
    <tbody>
      <%= render @staff_members %>
    </tbody>
  </table>
<% end %>
