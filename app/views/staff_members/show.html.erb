<% content_for :title, @staff_member.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @staff_member.name %></h1>
    <p class="card-text"><%= @staff_member.role %></p>
  </div>
</div>

<div class="mt-3">
  <% if policy(@staff_member).edit? %>
    <%= link_to "Edit", edit_staff_member_path(@staff_member), class: "btn btn-outline-secondary" %>
  <% end %>
  <% if policy(@staff_member).destroy? %>
    <%= button_to "Delete", @staff_member, method: :delete, data: { turbo_confirm: "Delete #{@staff_member.name}?" }, class: "btn btn-outline-danger d-inline-block" %>
  <% end %>
</div>

<h2 class="h5 mt-4"><%= pluralize(@repairs.size, "repair") %></h2>

<% if @repairs.empty? %>
  <p class="text-muted">No repairs assigned.</p>
<% else %>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Mechanic</th>
        <th>Taken in by</th>
        <th>Status</th>
        <th>Promised</th>
        <th>Diagnosis</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% end %>

<%= link_to "All staff", staff_members_path, class: "btn btn-outline-secondary mt-3" %>
