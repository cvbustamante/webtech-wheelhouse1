<%= form_with model: staff_member do |f| %>
  <% if staff_member.errors.any? %>
    <div class="alert alert-danger"><%= staff_member.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: ["form-control", { "is-invalid" => staff_member.errors[:name].any? }] %>
    <div class="invalid-feedback"><%= staff_member.errors[:name].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: ["form-control", { "is-invalid" => staff_member.errors[:role].any? }] %>
    <div class="invalid-feedback"><%= staff_member.errors[:role].to_sentence %></div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", staff_member.persisted? ? staff_member : staff_members_path, class: "btn btn-outline-secondary" %>
<% end %>
