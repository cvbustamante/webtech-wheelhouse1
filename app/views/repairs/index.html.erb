<h1>Repairs</h1>

<%= link_to "New repair", new_repair_path, class: "btn btn-primary mb-3" %>

<% if @repairs.empty? %>
  <p class="text-muted">No repairs yet.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Customer</th>
        <th>Mechanic</th>
        <th>Status</th>
        <th>Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% end %>
