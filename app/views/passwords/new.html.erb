<% content_for :title, "Forgot your password?" %>

<h1>Forgot your password?</h1>

<%= form_with url: passwords_path, class: "col-md-6 col-lg-4" do |form| %>
  <div class="mb-3">
    <%= form.label :email_address, class: "form-label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-control" %>
  </div>

  <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
  <%= link_to "Back to sign in", new_session_path, class: "btn btn-outline-secondary" %>
<% end %>
