<% content_for :title, @customer.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @customer.name %></h1>
    <p class="card-text"><%= @customer.phone %></p>
  </div>
</div>

<div class="mt-3">
  <% if policy(@customer).edit? %>
    <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-secondary" %>
  <% end %>
  <% if policy(@customer).destroy? %>
    <%= button_to "Delete", @customer, method: :delete, data: { turbo_confirm: "Delete #{@customer.name}?" }, class: "btn btn-outline-danger d-inline-block" %>
  <% end %>
</div>

<h2 class="h5 mt-4"><%= pluralize(@customer.bikes.size, "bike") %></h2>
<% if policy(Bike).new? %>
  <%= link_to "New bike", new_bike_path(customer_id: @customer.id), class: "btn btn-primary btn-sm mb-2" %>
<% end %>

<% if @customer.bikes.empty? %>
  <p class="text-muted">No bikes yet.</p>
<% else %>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Serial number</th>
        <th>Model</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customer.bikes.sort_by(&:serial_number) %>
    </tbody>
  </table>
<% end %>

<%= link_to "All customers", customers_path, class: "btn btn-outline-secondary mt-3" %>
