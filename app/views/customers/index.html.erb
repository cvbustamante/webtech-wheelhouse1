<h1>Customers</h1>

<%= link_to "New customer", new_customer_path, class: "btn btn-primary mb-3" %>

<% if @customers.empty? %>
  <p class="text-muted">No customers yet.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customers %>
    </tbody>
  </table>
<% end %>
