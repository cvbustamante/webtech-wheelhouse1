<%= form_with model: job do |f| %>
  <% if job.errors.any? %>
    <div class="alert alert-danger"><%= job.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: ["form-control", { "is-invalid" => job.errors[:name].any? }] %>
    <div class="invalid-feedback"><%= job.errors[:name].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= f.label :price, class: "form-label" %>
    <%= f.number_field :price, step: "0.01", class: ["form-control", { "is-invalid" => job.errors[:price].any? }] %>
    <div class="invalid-feedback"><%= job.errors[:price].to_sentence %></div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", job.persisted? ? job : jobs_path, class: "btn btn-outline-secondary" %>
<% end %>
