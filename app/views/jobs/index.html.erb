<h1>Services</h1>

<p>Our current bicycle repair services and prices.</p>

<%= link_to "New service", new_job_path, class: "btn btn-primary mb-3" %>

<% if @jobs.empty? %>
  <p class="text-muted">No services yet.</p>
<% else %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Service</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      <%= render @jobs %>
    </tbody>
  </table>
<% end %>
