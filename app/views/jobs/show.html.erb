<% content_for :title, @job.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @job.name %></h1>
    <p class="card-text"><%= number_to_currency(@job.price, unit: "$", precision: 0) %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to "Edit", edit_job_path(@job), class: "btn btn-outline-secondary" %>
  <%= button_to "Delete", @job, method: :delete, data: { turbo_confirm: "Delete #{@job.name}?" }, class: "btn btn-outline-danger d-inline-block" %>
  <%= link_to "All services", jobs_path, class: "btn btn-outline-secondary" %>
</div>
