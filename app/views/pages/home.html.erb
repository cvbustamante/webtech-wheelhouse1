<h1>Wheelhouse</h1>

<p>Wheelhouse is a neighbourhood bicycle repair shop.</p>

<div class="row">
  <div class="col-md-4">
    <h2>Services</h2>
    <p>See our bicycle repair services and prices.</p>
    <%= link_to "View services", jobs_path, class: "btn btn-primary" %>
  </div>

  <div class="col-md-4">
    <h2>Visit us</h2>
    <p>Find out what happens when you bring your bike to the workshop.</p>
    <%= link_to "Visiting the workshop", visiting_path, class: "btn btn-primary" %>
  </div>

  <div class="col-md-4">
    <h2>About</h2>
    <p>Learn more about Wheelhouse.</p>
    <%= link_to "About us", about_path, class: "btn btn-primary" %>
  </div>
</div>