<h1>Services</h1>

<p>Our current bicycle repair services and prices.</p>

<table class="table">
  <thead>
    <tr>
      <th>Service</th>
      <th>Price</th>
    </tr>
  </thead>

  <tbody>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= job[:name] %></td>
        <td>$<%= job[:price] %></td>
      </tr>
    <% end %>
  </tbody>
</table>